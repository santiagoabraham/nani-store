# ============================================================
# Supabase — required for all environments
# ============================================================
# Copiar este archivo a .env.local y reemplazar los placeholders
# con los valores reales del dashboard (Project Settings → API).
# .env.local está en .gitignore y NUNCA se commitea.
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Service role key — server-side only, NEVER expose to the browser.
# Used by createServiceClient() for order creation, coupon claims,
# settings writes, and the MercadoPago webhook handler.
#
# Bypasea RLS por completo: quien la tenga puede leer, modificar y
# borrar todas las tablas, incluidos los pedidos con datos personales
# de los clientes. No pegarla acá ni en ningún archivo versionado.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# ============================================================
# Multi-tenancy
# ============================================================
# Slug of the tenant that / and legacy routes (/products, /admin, /checkout) redirect to.
DEFAULT_TENANT_SLUG=my-store

# ============================================================
# MercadoPago (per-tenant — stored in store_settings, not .env)
# ============================================================
# mp_access_token, mp_public_key, and mp_webhook_secret are stored
# per-tenant in the store_settings table and set via the admin UI.
# They are NOT environment variables.

# ============================================================
# App
# ============================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
